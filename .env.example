DATABASE_URL="file:./dev.db"

# --- IA (tudo free tier) -----------------------------------------------
# Gemini: https://aistudio.google.com/apikey  (grátis, sem cartão)
GEMINI_API_KEY=""

# Groq: https://console.groq.com/keys  (grátis) — usado para transcrever VSL
GROQ_API_KEY=""

# Opcional: se um dia quiser qualidade máxima de copy
ANTHROPIC_API_KEY=""

# qual provider os agentes usam: gemini | groq | anthropic
LLM_PROVIDER="gemini"

# --- coleta -------------------------------------------------------------
# 1 = mostra a janela do Chrome durante a coleta. Deixe vazio para rodar
# invisível. Só ligue se a Meta pedir captcha/login e você precisar resolver
# na mão — o perfil é persistente, então resolver uma vez basta.
SCRAPER_HEADFUL=""
